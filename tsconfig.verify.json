{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "scripts/.verify-out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "scripts/verify-editor-store.ts",
    "scripts/verify-byo-agents.ts",
    "scripts/verify-particle-layout.ts",
    "shared/byo-agents.ts",
    "shared/particle-layout.ts",
    "shared/particle-rendering.ts",
    "shared/particle-shapes.ts",
    "src/stores/create-editor-store.ts",
    "src/stores/editor-store-factory.ts",
    "src/stores/graph-store.ts",
    "src/types/index.ts",
    "shared/paths.ts",
    "shared/tab-close-policy.ts",
    "src/lib/paths.ts",
    "src/lib/webmcp-notes.ts",
    "src/lib/wiki-link.ts",
    "scripts/verify-wiki-link.ts"
  ]
}
